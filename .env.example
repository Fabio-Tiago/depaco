# ============================================
# DEPACO — variáveis de ambiente
# Copia este arquivo para .env.local e preenche
# ============================================

# Algolia — pega em https://www.algolia.com/account/api-keys
NEXT_PUBLIC_ALGOLIA_APP_ID=xxxxx
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=xxxx
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=depaco

# Supabase Storage (para construir URLs de imagens)
NEXT_PUBLIC_SUPABASE_PROJECT_REF=xxxxxxx
NEXT_PUBLIC_SUPABASE_BUCKET=Desenhos_para_Colorir

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=DEPACO

# Pack premium — link de checkout (Hotmart/Eduzz/Stripe — escolher depois)
NEXT_PUBLIC_PACK_CHECKOUT_URL=https://pay.hotmart.com/SEU_LINK_AQUI
NEXT_PUBLIC_PACK_PRICE=7.90
NEXT_PUBLIC_PACK_QUANTITY=500

# Pack temático — Esporte / Copa / Futebol / Olimpíadas
NEXT_PUBLIC_PACK_ESPORTE_CHECKOUT_URL=https://pay.hotmart.com/SEU_LINK_ESPORTE
NEXT_PUBLIC_PACK_ESPORTE_PRICE=5.90
NEXT_PUBLIC_PACK_ESPORTE_QUANTITY=300
